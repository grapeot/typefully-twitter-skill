# Typefully v2 API token for publishing and draft management.
TYPEFULLY_API_KEY=replace-with-your-real-typefully-api-key
TYPEFULLY_SOCIAL_SET_ID=123456

# Typefully web-session credentials for account-level metrics.
TYPEFULLY_AUTHORIZATION=replace-with-your-typefully-web-authorization-header
TYPEFULLY_ACCOUNT=replace-with-your-typefully-account-id
TYPEFULLY_SESSION=replace-with-your-typefully-session-id
TYPEFULLY_COOKIE=replace-with-your-typefully-cookie-header-if-needed
TYPEFULLY_BASE_URL=https://typefully.com
TYPEFULLY_TIMEOUT=30

# X / Twitter analytics.x.com browser cookies.
X_AUTH_TOKEN=replace-with-your-x-auth-token-cookie
X_CSRF_TOKEN=replace-with-your-x-csrf-cookie
X_USER_ID=123456789

# Optional local storage configuration for the future implementation.
TYPEFULLY_TWITTER_DATA_DIR=data
TYPEFULLY_TWITTER_DB_PATH=data/twitter_analytics.db
